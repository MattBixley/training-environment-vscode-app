<%
   pwd_cfg = "c.ServerApp.password=u\'sha1:${SALT}:${PASSWORD_SHA1}\'"
   host_port_cfg = "c.ServerApp.base_url=\'/node/${HOST_CFG}/${PORT_CFG}/\'"

   configmap_filename = "ondemand_config.py"
   configmap_data = "c.NotebookApp.port = 8080"
   utility_img = "ghcr.io/nesi/training-environment-k8s-utils:v0.1.0"

   user = OodSupport::User.new

   services_node = Resolv.getaddress("servicesnode")

   # The node's GPUs, one form control per card. "off" leaves the card out
   # entirely, so asking for it is refused rather than quietly satisfied by
   # whatever else is free. Falls back to a single L4 if every card is off,
   # because a session with no GPU at all is never what anyone meant.
   fleet = {
     "l4"       => vram_l4,
     "a100_40"  => vram_a100_40,
     "a100"     => vram_a100,
     "h100"     => vram_h100,
     "pro_6000" => vram_pro_6000,
   }.reject { |_, vram| vram.to_s.strip.empty? || vram.to_s.strip == "off" }
    .map { |card, vram| "#{card}:#{vram}" }
    .join(",")
   fleet = "l4:1GiB" if fleet.empty?
%>
---
script:
  accounting_id: "<%= account %>"
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    container:
      name: "gpu"
      # This tag is what the session actually runs, and it must match the git
      # tag this file is released under. The training-environment config's
      # `k8s_container` does NOT control it - that value only tells the pod
      # pre-puller which image to cache on the worker nodes. Bump both together
      # on every release; CI enforces it on tag builds.
      image: "ghcr.io/nesi/training-environment-jupyter-gpu-app:v0.5.3"
      command: ["/bin/bash","-l","<%= staged_root %>/job_script_content.sh"]
      working_dir: "<%= Etc.getpwnam(ENV['USER']).dir %>"
      restart_policy: 'OnFailure'
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
        LOG_DIR: "<%= staged_root %>"
        SHELL: "/bin/bash"
        # Which cards the node presents, and how much memory each one has.
        # Entries are name[:count][:vram]; read by gpuemud at startup, and by
        # sbatch to decide whether a requested card exists. See gpuemu/spec.py
        # for the device definitions.
        GPUEMU_FLEET: "<%= fleet %>"
      port: "8080"
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
    mounts:
      - type: nfs
        name: home
        host: <%= services_node %>
        path: /srv/homes
        destination_path: /home/shared
      - type: host
        name: nslcd-socket
        host_type: Socket
        path: /var/run/nslcd/socket
        destination_path: /var/run/nslcd/socket
      - type: host
        name: nsswitch-conf
        host_type: File
        path: /etc/nsswitch.conf
        destination_path: /etc/nsswitch.conf
    configmap:
      files:
        - filename: 'k8_helper'
          data: |
            #!/usr/bin/env bash

            set -x

            KEY=$1
            VALUE=$(echo -n $2 | base64)
            CFG="$(hostname)-secret"

            kubectl get secret ${CFG} -o json | jq --arg key $KEY --arg value $VALUE '.data[$key] = $value'  | kubectl apply -f -
          mount_path: '/opt/open_ondemand/helpers'
