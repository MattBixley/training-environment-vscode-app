#!/usr/bin/env bash

# send all output to pod.log
exec &> >(tee -a "${LOG_DIR}/pod.log")

echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

# ---------------------------------------------------------------------------
# GPU and Slurm emulators, switched on from the launch form (GPUEMU_ENABLE).
#
# gpuemud maintains the device state that nvidia-smi and nvtop read, and
# gpuemu-slurmd runs submitted batch jobs. Both have to be up before VS Code
# starts, otherwise the first nvidia-smi a learner runs fails.
# ---------------------------------------------------------------------------
if [[ "${GPUEMU_ENABLE:-0}" == "1" ]]; then
    mkdir -p /run/gpuemu/claims /run/gpuemu/slurm/jobs
    chmod 1777 /run/gpuemu /run/gpuemu/claims /run/gpuemu/slurm /run/gpuemu/slurm/jobs || true

    gpuemu-ctl start

    # Fail loudly here rather than leaving a session where the GPU silently is
    # not there.
    if ! nvidia-smi -L; then
        echo "ERROR: the GPU emulator did not start. GPU exercises will not work." >&2
        gpuemu-ctl status >&2 || true
        cat /run/gpuemu/gpuemud.log >&2 || true
    fi

    echo "TIMING - GPU emulator started at: $(date)"
else
    # no daemons are running, so stop torch/numba imports claiming a device
    export GPUEMU_AUTOCLAIM=0
    echo "GPU and Slurm emulators are off for this session"
fi

# ---------------------------------------------------------------------------
# VS Code
#
# Extensions baked into the image are copied into the user's own extensions
# directory, never overwriting what is there, so learners can add and update
# their own. Default settings are only written when the user has none.
# ---------------------------------------------------------------------------
CODE_SERVER_DATAROOT="${HOME}/.local/share/code-server"
mkdir -p "${CODE_SERVER_DATAROOT}/extensions" "${CODE_SERVER_DATAROOT}/User"
rsync --ignore-existing -a /opt/code-server/extensions/ "${CODE_SERVER_DATAROOT}/extensions/"
if [[ ! -f "${CODE_SERVER_DATAROOT}/User/settings.json" ]]; then
    cp /opt/code-server/settings.json "${CODE_SERVER_DATAROOT}/User/settings.json"
fi

echo "TIMING - Starting code-server at: $(date)"

exec code-server \
    --auth="password" \
    --bind-addr="0.0.0.0:8443" \
    --disable-telemetry \
    --disable-update-check \
    --user-data-dir="${CODE_SERVER_DATAROOT}" \
    --extensions-dir="${CODE_SERVER_DATAROOT}/extensions" \
    "${HOME}"
